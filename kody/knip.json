{
	"$schema": "https://unpkg.com/knip@5/schema.json",
	"include": ["files", "exports", "types"],
	"workspaces": {
		".": {
			"entry": ["tools/**/*.{ts,js,mjs}", "e2e/**/*.ts", "vitest*.ts"],
			"project": ["tools/**/*.{ts,js,mjs}", "*.ts", "e2e/**/*.ts"]
		},
		"packages/worker": {
			"entry": [
				"client/entry.tsx",
				"src/mcp/capabilities/**/*.ts",
				"src/mcp/instructions/**/*.ts"
			],
			"project": [
				"src/**/*.{ts,tsx}",
				"client/**/*.{ts,tsx}",
				"universal/**/*.{ts,tsx}"
			]
		},
		"packages/shared": {
			"entry": ["src/**/*.ts"],
			"project": ["src/**/*.ts"]
		}
	}
}
