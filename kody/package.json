{
  "name": "kody",
  "private": true,
  "version": "0.0.0",
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "imports": {
    "#app/*": "./packages/worker/src/app/*",
    "#client/*": "./packages/worker/client/*",
    "#universal/*": "./packages/worker/universal/*",
    "#worker/*": "./packages/worker/src/*",
    "#*": "./*",
    "#mcp/*": "./packages/worker/src/mcp/*"
  },
  "description": "Your assistant's home — the memory, keys, code, and automations your AI agent keeps, portable across every MCP host",
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning tools/demo/launcher.ts",
    "dev:client": "vite",
    "clean:client": "node -e \"const{rmSync}=require('node:fs');for(const p of ['packages/worker/public/assets','packages/worker/public/client-manifest.json','dist'])rmSync(p,{recursive:true,force:true})\"",
    "build:client": "vite build",
    "build": "vite build",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "primitives:check": "node .agents/skills/visual-recap/scripts/check-primitives-map.mjs",
    "primitives:classify": "node .agents/skills/visual-recap/scripts/classify-primitives.mjs",
    "docs:check-temporal": "node tools/check-docs-temporal-language.ts",
    "docs:check-decisions": "node tools/check-decision-record-numbers.ts",
    "lockfile:check": "node tools/check-lockfile-peer-drift.ts",
    "mermaid:check": "node tools/check-mermaid-syntax.ts",
    "file-size-ratchet:check": "node tools/check-file-size-ratchet.ts",
    "decorative-banners:check": "node tools/check-decorative-banners.ts",
    "slop-ratchet:check": "node tools/check-file-size-ratchet.ts && node tools/check-decorative-banners.ts",
    "knip": "knip",
    "migrations:check": "node tools/check-migrations.ts",
    "e2e:web-server": "node tools/e2e-web-server.ts",
    "preview:manual-test": "node tools/preview-manual-test.ts",
    "control-kody": "node tools/control-kody.ts",
    "maintenance-mode": "node tools/maintenance-mode.ts",
    "site-perf": "node tools/site-perf/collect.ts",
    "typecheck": "tsc -b packages/worker/tsconfig-client.json packages/worker/tsconfig-worker-typecheck.json --noEmit",
    "test": "npm run test:node",
    "test:node": "node tools/run-nx.ts run worker:test-node",
    "test:push": "CI=1 npm run test:node",
    "inspect": "npx -y @mcpjam/inspector inspector",
    "prevalidate": "node tools/build-worker-bundler-modules.ts && node tools/build-guide-catalog-modules.ts",
    "validate": "concurrently -n format,lint,typecheck,node,primitives,migrations,docs-temporal,docs-decisions,mermaid,slop-ratchet,knip,audit,lockfile,cloudflare \"npm run format:check\" \"npm run lint\" \"npm run typecheck\" \"npm run test:node\" \"npm run primitives:check\" \"npm run migrations:check\" \"npm run docs:check-temporal\" \"npm run docs:check-decisions\" \"npm run mermaid:check\" \"npm run slop-ratchet:check\" \"npm run knip\" \"npm run audit:prod\" \"npm run lockfile:check\" \"npm run cloudflare:check\"",
    "validate:fix": "npm run format && npm run lint:fix",
    "test:e2e:ensure": "node tools/ensure-playwright-browser.ts",
    "test:e2e:a11y": "playwright test e2e/a11y.spec.ts",
    "test:e2e:run": "node tools/run-nx.ts run worker:test-e2e",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "node tools/ensure-playwright-browser.ts",
    "test:mcp": "node tools/run-nx.ts run worker:test-mcp",
    "nx:graph": "nx graph",
    "nx:show-projects": "nx show projects",
    "audit:prod": "npm audit --omit=dev --audit-level=moderate",
    "cloudflare:check": "node tools/check-cloudflare-references.ts",
    "demo": "node --disable-warning=ExperimentalWarning tools/demo/launcher.ts",
    "demo:run": "node tools/demo/scenario.ts",
    "demo:reset": "node tools/demo/launcher.ts --reset",
    "demo:check": "node tools/demo/check.ts",
    "demo:aws:check": "node tools/demo/aws-check.ts",
    "docs:check-poc": "node tools/demo/check-docs.ts",
    "demo:runner:build": "node tools/demo/build-runner.ts",
    "test:e2e:demo": "playwright test --config playwright.demo.config.ts",
    "demo:typecheck": "tsc -p tools/demo/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@aws-sdk/client-bedrock-agentcore": "^3.1143.0",
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pgvector": "^0.0.9",
    "@epic-web/config": "^3.2.1",
    "@kody-internal/shared": "file:packages/shared",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@pitlane/dev": "^0.6.0",
    "@playwright/test": "^1.62.1",
    "@sentry/cli": "^3.7.0",
    "@temporalio/activity": "^1.24.0",
    "@temporalio/client": "^1.24.0",
    "@temporalio/proto": "^1.24.0",
    "@temporalio/testing": "^1.24.0",
    "@temporalio/worker": "^1.24.0",
    "@temporalio/workflow": "^1.24.0",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "@types/semver": "^7.8.0",
    "concurrently": "^10.0.5",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.2",
    "get-port": "^7.2.0",
    "kleur": "^4.1.5",
    "knip": "^6.34.0",
    "mermaid": "^11.17.2",
    "msw": "^2.15.0",
    "nx": "^23.2.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "semver": "^7.8.5",
    "set-cookie-parser": "^3.1.2",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "workerd": "^1.20260815.1"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "brace-expansion": "^5.0.9",
    "hono": ">=4.13.7 <5.0.0",
    "@hono/node-server": ">=2.0.10 <3.0.0",
    "postcss": ">=8.5.10 <9.0.0",
    "isomorphic-git": ">=1.40.0 <1.40.8"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "npm@11.11.1",
  "workspaces": [
    "packages/shared",
    "packages/worker"
  ],
  "allowScripts": {
    "@sentry/cli": true,
    "core-js-pure": true,
    "esbuild": true,
    "fsevents": true,
    "msw": true,
    "nx": true,
    "sharp": true,
    "unrs-resolver": true,
    "workerd": true
  }
}
